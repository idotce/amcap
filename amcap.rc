#pragma code_page(65001)
#include <windows.h>
#include <activex.ver>
#include "amcap.h"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

//
// Icons
//
AMCapIcon ICON "amcap.ico"

//
// Main menu
//
ID_APP menu
BEGIN
    POPUP "文件(&F)"
    BEGIN
            MENUITEM "设置采集文件(&C)..."         , MENU_SET_CAP_FILE
            MENUITEM "预分配文件空间(&A)..."      , MENU_ALLOC_CAP_FILE
            MENUITEM "保存采集的视频(&S)..."      , MENU_SAVE_CAP_FILE
            MENUITEM SEPARATOR
            MENUITEM "退出(&X)"                        , MENU_EXIT
        END
    POPUP "设备(&D)"
        BEGIN
            MENUITEM SEPARATOR
    END
    POPUP "选项(&O)"
        BEGIN
            MENUITEM "预览(&P)"             , MENU_PREVIEW
        MENUITEM SEPARATOR
            MENUITEM "MPEG-2(&M)"               , MENU_MPEG2
            MENUITEM SEPARATOR
            MENUITEM "音频格式(&A)..."     , MENU_AUDIOFORMAT
            MENUITEM SEPARATOR
        /* VIDEO dialogs are created dynamically */
        END
    POPUP "采集(&C)"
        BEGIN
            MENUITEM "开始采集(&S)"       , MENU_START_CAP
            MENUITEM "停止采集(&P)"        , MENU_STOP_CAP
            MENUITEM SEPARATOR
            MENUITEM "采集音频(&A)"       , MENU_CAP_AUDIO
            MENUITEM "隐藏式字幕(&C)"   , MENU_CAP_CC
            POPUP    "主同步流(&M)"
        BEGIN
            MENUITEM "无(&N)"                , MENU_NOMASTER
            MENUITEM "音频(&A)"               , MENU_AUDIOMASTER
            MENUITEM "视频(&V)"               , MENU_VIDEOMASTER
        END
            MENUITEM "设置帧率(&F)..."   , MENU_FRAMERATE
            MENUITEM "设置时长限制(&T)..."   , MENU_TIMELIMIT
        END
    POPUP "帮助(&H)"
        BEGIN
            MENUITEM "关于(&A)..."            , MENU_ABOUT
        END
END

//
// Dialogs
//

// About Dialog
IDD_ABOUT DIALOG DISCARDABLE  10, 20, 215, 78
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "关于 AMCap"
FONT 8, "MS Shell Dlg"
BEGIN
    CTEXT           "AMCap - DirectShow 视频采集示例",-1,23,
                    8,170,8,NOT WS_GROUP
    CTEXT           "版本 9.00",-1,41,23,134,8,NOT WS_GROUP
    CTEXT           "Copyright (C) Microsoft Corp.",-1,23,
                    38,170,8,NOT WS_GROUP
    DEFPUSHBUTTON   "确定",IDOK,91,53,32,14,WS_GROUP
    ICON            "AMCAPICON"-1,7,17,21,20
END

IDD_AllocCapFileSpace DIALOG 6, 18, 160, 105
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | DS_3DLOOK
CAPTION "设置文件大小"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "请输入为采集文件预留的磁盘空间。", -1, 5, 9, 130,
                    8
    LTEXT           "文件中已有的视频数据将被删除。", -1, 5, 19,
                    135, 8
    LTEXT           "", -1, 5, 29, 93, 8
    LTEXT           "可用磁盘空间：", -1, 5, 50, 59, 8
    LTEXT           "     ", IDD_SetCapFileFree, 73, 50, 20, 8
    LTEXT           "MB", -1, 96, 50, 27, 8
    LTEXT           "采集文件大小：", -1, 5, 64, 60, 8
    EDITTEXT        IDD_SetCapFileSize, 65, 64, 28, 12, ES_AUTOHSCROLL
    LTEXT           "MB", -1, 96, 64, 27, 8
    PUSHBUTTON      "确定", IDOK, 38, 84, 40, 14
    PUSHBUTTON      "取消", IDCANCEL, 88, 84, 40, 14
END


IDD_PressAKeyDialog DIALOG LOADONCALL MOVEABLE DISCARDABLE 12, 29, 121, 60
CAPTION "准备采集"
FONT 8, "MS Shell Dlg"
STYLE WS_BORDER | WS_CAPTION | WS_DLGFRAME | WS_SYSMENU | DS_MODALFRAME | WS_POPUP
BEGIN
    CONTROL "点击“确定”开始采集视频到：",
        -1, "static", SS_LEFT | WS_CHILD, 5, 4, 100, 16
    CONTROL "", IDC_CAPFILENAME, "static", SS_LEFT | WS_CHILD, 5, 23, 100, 16
    CONTROL "确定", IDOK, "button", BS_DEFPUSHBUTTON | WS_TABSTOP | WS_CHILD,
        18, 42, 32, 14
    CONTROL "取消", IDCANCEL, "button", BS_PUSHBUTTON | WS_TABSTOP | WS_CHILD,
        69, 42, 32, 14
END


IDD_FrameRateDialog DIALOG LOADONCALL MOVEABLE DISCARDABLE 12, 29, 121, 50
CAPTION "设置帧率"
FONT 8, "MS Shell Dlg"
STYLE WS_BORDER | WS_CAPTION | WS_DLGFRAME | WS_SYSMENU | DS_MODALFRAME | WS_POPUP
BEGIN
    CONTROL "", IDC_USEFRAMERATE "button", BS_AUTOCHECKBOX | WS_TABSTOP, 3, 4, 9, 8
    CONTROL "启用帧率限制", -1, "static", SS_LEFT | WS_CHILD, 13, 4, 73, 8
    CONTROL "帧率(&F)：", -1, "static", SS_LEFT | WS_CHILD, 3, 18, 43, 8
    CONTROL "", IDC_FRAMERATE, "edit", WS_BORDER | WS_TABSTOP | WS_CHILD, 44, 16, 44, 12
    CONTROL "帧/秒", -1, "static", SS_LEFT | WS_CHILD, 93, 18, 18, 8
    CONTROL "确定", IDOK, "button", BS_DEFPUSHBUTTON | WS_TABSTOP | WS_CHILD, 18, 33, 32, 14
    CONTROL "取消", IDCANCEL, "button", BS_PUSHBUTTON | WS_TABSTOP | WS_CHILD, 69, 33, 32, 14
END


IDD_TimeLimitDialog DIALOG LOADONCALL MOVEABLE DISCARDABLE 12, 29, 121, 50
CAPTION "采集时长限制"
FONT 8, "MS Shell Dlg"
STYLE WS_BORDER | WS_CAPTION | WS_DLGFRAME | WS_SYSMENU | DS_MODALFRAME | WS_POPUP
BEGIN
    CONTROL "", IDC_USETIMELIMIT "button", BS_AUTOCHECKBOX | WS_TABSTOP, 3, 4, 9, 8
    CONTROL "启用时长限制", -1, "static", SS_LEFT | WS_CHILD, 13, 4, 73, 8
    CONTROL "时长(&T)：", -1, "static", SS_LEFT | WS_CHILD, 3, 18, 43, 8
    CONTROL "", IDC_TIMELIMIT, "edit", WS_BORDER | WS_TABSTOP | WS_CHILD, 44, 16, 44, 12
    CONTROL "秒", -1, "static", SS_LEFT | WS_CHILD, 93, 18, 18, 8
    CONTROL "确定", IDOK, "button", BS_DEFPUSHBUTTON | WS_TABSTOP | WS_CHILD, 18, 33, 32, 14
    CONTROL "取消", IDCANCEL, "button", BS_PUSHBUTTON | WS_TABSTOP | WS_CHILD, 69, 33, 32, 14
END

